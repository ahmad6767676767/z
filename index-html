      return <i data-lucide={name} className={className}></i>;
    };

    const ToastContainer = ({ toasts, removeToast }) => {
      return (
        <div className="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none">
          {toasts.map(toast => (
            <div 
              key={toast.id}
              className="pointer-events-auto flex items-center gap-3 bg-slate-900/95 dark:bg-slate-800/95 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700/60 backdrop-blur-md animate-toast-slide max-w-sm"
            >
              <div className={`p-2 rounded-xl shrink-0 ${
                toast.type === 'success' ? 'bg-emerald-500/20 text-emerald-400' : 
                toast.type === 'email' ? 'bg-sky-500/20 text-sky-400' : 
                'bg-brand-500/20 text-brand-400'
              }`}>
                <Icon name={toast.icon || 'info'} className="w-5 h-5" />
              </div>
              <div className="flex-1 text-sm min-w-0">
                <p className="font-semibold text-slate-100 truncate">{toast.title}</p>
                {toast.message && <p className="text-xs text-slate-400 mt-0.5 line-clamp-2">{toast.message}</p>}
              </div>
              <button 
                onClick={() => removeToast(toast.id)}
                className="text-slate-400 hover:text-white p-1 rounded-lg transition-colors"
              >
                <Icon name="x" className="w-4 h-4" />
              </button>
            </div>
          ))}
