              </button>

              {/* Upload Pin Button */}
              <button
                onClick={onOpenUpload}
                className="flex items-center gap-1.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold text-xs sm:text-sm px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-full shadow-lg shadow-brand-500/25 transition-all hover:scale-[1.02] active:scale-[0.98]"
              >
                <Icon name="plus" className="w-4 h-4" />
                <span className="hidden sm:inline">Upload</span>
