    // Helper to format Unsplash URLs with dynamic parameters
    const getUnsplashUrl = (photoId, width = 800, quality = 80) => {
      return `https://images.unsplash.com/photo-${photoId}?auto=format&fit=crop&w=${width}&q=${quality}`;
    };

    // Dynamic generator that creates dynamic wallpaper records for search queries
    const generateDynamicWallpapersForQuery = (query, count = 12) => {
      const categories = ['Cyberpunk', 'Anime', 'Space', 'Nature', 'AMOLED', 'Minimal', 'Cars', 'Gaming', 'Fantasy', 'Architecture', 'Abstract'];
      const aspectRatios = ['tall', 'extra-tall', 'square', 'wide', 'ultrawide'];
      const resolutions = ['4K Ultra', '8K Ultra', '4K OLED', 'HD Desktop'];

      // Deterministic sample photo IDs from Unsplash high quality collection
      const photoPool = [
        '1514565131-fce0801e5785', '1519681393784-d120267933ba', '1506703719100-a0f3a48c0f86',
        '1503899036084-c55cdd92da26', '1618005182384-a83a8bd57fbe', '1448375240586-882707db888b',
        '1513694203232-719a280e022f', '1544551763-46a013bb70d5', '1509316975850-ff9c5deb0cd9',
        '1550684848-fac1c5b4e853', '1522383225653-ed111181a951', '1502134249126-9f3755a50d78',
        '1541701494587-cb58502866ab', '1578632767115-351597cf2477', '1563720223185-11003d516935',
        '1518709268805-4e9042af9f23', '1511512578047-dfb367046420', '1507525428034-b723cf961d3e'
      ];

      const capitalizedQuery = query.charAt(0).toUpperCase() + query.slice(1);

      return Array.from({ length: count }, (_, idx) => {
        const photoId = photoPool[idx % photoPool.length];
        const aspect = aspectRatios[idx % aspectRatios.length];
        const res = resolutions[idx % resolutions.length];
        const categoryMatch = categories.find(c => c.toLowerCase() === query.toLowerCase()) || categories[idx % categories.length];

        return {
          id: `dyn-${query.toLowerCase().replace(/\s+/g, '-')}-${idx + 1}`,
          title: `${capitalizedQuery} ${idx === 0 ? 'Masterpiece' : 'Wallpaper'} #${idx + 1}`,
          category: categoryMatch,
          aspectRatio: aspect,
          aspectLabel: aspect === 'tall' ? '9:16 Mobile' : aspect === 'extra-tall' ? '9:20 OLED' : aspect === 'square' ? '1:1 Square' : aspect === 'ultrawide' ? '21:9 Ultrawide' : '16:9 Desktop',
          resolution: res,
          imageUrl: getUnsplashUrl(photoId, 900, 85),
          creator: {
            name: ['Aria Vance', 'Kaito Takahashi', 'Elena Rostova', 'Nova Koster', 'Lucas Sterling', 'Sven Lindqvist'][idx % 6],
            avatar: `https://images.unsplash.com/photo-${['1534528741775-53994a69daeb', '1500648767791-00dcc994a43e', '1494790108377-be9c29b29330', '1517841905240-472988babdf9', '1507003211169-0a1dd7228f2d', '1522075469751-3a6694fb2f61'][idx % 6]}?auto=format&fit=crop&w=120&q=80`,
            handle: `@creator_${idx + 1}`
          },
          likes: Math.floor(1200 + (idx * 340) + Math.random() * 500),
          downloads: Math.floor(800 + (idx * 210) + Math.random() * 300),
          createdAt: '2026-09-28',
          palette: ['#0f172a', '#e60023', '#3b82f6', '#10b981', '#f59e0b'],
          tags: [query.toLowerCase(), categoryMatch.toLowerCase(), '4k', 'wallpaper', 'hd']
        };
      });
    };

    const CATEGORIES = [
      'All', 'Cyberpunk', 'Anime', 'Space', 'Nature', 'AMOLED', 
      'Minimal', 'Cars', 'Gaming', 'Fantasy', 'Architecture', 'Abstract'
    ];

    const ASPECT_RATIOS = [
      { key: 'all', label: 'All Ratios', icon: 'grid' },
      { key: 'tall', label: 'Mobile (9:16)', icon: 'smartphone' },
      { key: 'wide', label: 'Desktop (16:9)', icon: 'monitor' },
      { key: 'ultrawide', label: 'Ultrawide (21:9)', icon: 'tv' },
      { key: 'square', label: 'Square (1:1)', icon: 'square' },
    ];

    const COLOR_PALETTES = [
      { name: 'All Colors', hex: null },
      { name: 'Crimson Red', hex: '#ef4444' },
      { name: 'Neon Pink', hex: '#ec4899' },
      { name: 'Cyber Purple', hex: '#a855f7' },
      { name: 'Ocean Blue', hex: '#3b82f6' },
