      { id: '1563720223185-11003d516935', title: 'Hypercar Matte Black Midnight Drift', category: 'Cars', aspectRatio: 'ultrawide', aspectLabel: '21:9 Ultrawide', resolution: '8K Ultra', palette: ['#09090b', '#18181b', '#3f3f46', '#9ca3af'], tags: ['cars', 'supercar', 'dark', 'speed', 'black'] },
      { id: '1518709268805-4e9042af9f23', title: 'Enchanted Crystal Citadel Kingdom', category: 'Fantasy', aspectRatio: 'tall', aspectLabel: '9:16 Mobile', resolution: '4K Ultra', palette: ['#0f172a', '#1e1b4b', '#818cf8', '#c084fc'], tags: ['fantasy', 'castle', 'magic', 'crystal', 'glowing'] },
      { id: '1511512578047-dfb367046420', title: 'Retro Arcade Cyber Deck Setup', category: 'Gaming', aspectRatio: 'wide', aspectLabel: '16:9 Desktop', resolution: '4K Ultra', palette: ['#09090b', '#581c87', '#ec4899', '#38bdf8'], tags: ['gaming', 'setup', 'rgb', 'arcade', 'retro'] },
