      { id: '1513694203232-719a280e022f', title: 'Brutalist Monolithic Geometric Atrium', category: 'Architecture', aspectRatio: 'square', aspectLabel: '1:1 Square', resolution: '4K Ultra', palette: ['#18181b', '#3f3f46', '#71717a', '#e4e4e7'], tags: ['architecture', 'monochrome', 'concrete', 'minimal'] },
      { id: '1544551763-46a013bb70d5', title: 'Bioluminescent Abyss Ocean Jellyfish', category: 'AMOLED', aspectRatio: 'extra-tall', aspectLabel: '9:19 Vertical', resolution: '4K OLED', palette: ['#030712', '#0f172a', '#06b6d4', '#22d3ee'], tags: ['amoled', 'dark', 'ocean', 'jellyfish', 'glowing'] },
