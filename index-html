                <div>
                  <label className="block text-xs font-bold uppercase text-slate-400 mb-1">Aspect Ratio</label>
                  <select
                    value={aspectRatio}
                    onChange={(e) => setAspectRatio(e.target.value)}
                    className="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl px-2.5 py-2 text-xs font-semibold"
                  >
                    <option value="tall">Mobile 9:16</option>
                    <option value="wide">Desktop 16:9</option>
                    <option value="square">Square 1:1</option>
                  </select>
                </div>
              </div>

              <div className="flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-slate-800">
                <button type="button" onClick={onClose} className="px-4 py-2 text-xs font-bold text-slate-500">Cancel</button>
                <button type="submit" className="px-5 py-2.5 bg-brand-500 text-white font-bold text-xs rounded-full shadow-lg">Publish Pin</button>
              </div>
            </form>
          </div>
        </div>
      );
    };

    const SavedPinsView = ({ 
      savedPins, 
      wallpapers, 
      userBoards, 
      onCreateBoard, 
      onSelectWallpaper,
      onSavePin,
      onToggleLike,
      likedIds,
      onQuickDownload,
      onOpenSendEmailModal,
      onOpenEmailBoardsModal
    }) => {
      const [activeBoardFilter, setActiveBoardFilter] = useState('All');
      const [newBoardName, setNewBoardName] = useState('');
      const [showNewBoardInput, setShowNewBoardInput] = useState(false);

      const savedItems = wallpapers.filter(w => savedPins[w.id]);
      const filteredSavedItems = activeBoardFilter === 'All' 
        ? savedItems 
        : savedItems.filter(w => savedPins[w.id] === activeBoardFilter);

      const handleAddBoardSubmit = (e) => {
        e.preventDefault();
        if (newBoardName.trim()) {
          onCreateBoard(newBoardName.trim());
          setActiveBoardFilter(newBoardName.trim());
          setNewBoardName('');
          setShowNewBoardInput(false);
        }
      };

      return (
        <div className="max-w-[1700px] mx-auto px-4 sm:px-6 py-6">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
              <h1 className="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                <Icon name="bookmark" className="w-7 h-7 text-brand-500 fill-brand-500" />
                Your Pin Collections
              </h1>
              <p className="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                {savedItems.length} wallpapers saved in {userBoards.length} custom boards
              </p>
            </div>

            <div className="flex items-center gap-2">
              <button
                onClick={onOpenEmailBoardsModal}
                className="px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white text-xs font-bold rounded-full shadow-md flex items-center gap-1.5 transition-transform active:scale-95"
              >
                <Icon name="mail" className="w-4 h-4" />
                Email My Boards
              </button>

              <button
                onClick={() => setShowNewBoardInput(!showNewBoardInput)}
                className="px-4 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold rounded-full shadow-md flex items-center gap-1.5 transition-transform active:scale-95"
              >
                <Icon name="folder-plus" className="w-4 h-4" />
                Create Board
              </button>
            </div>
          </div>

          {showNewBoardInput && (
            <form onSubmit={handleAddBoardSubmit} className="mb-6 p-4 bg-slate-200/60 dark:bg-slate-800/80 rounded-2xl flex items-center gap-2 max-w-md animate-fade-in">
              <input
                type="text"
                value={newBoardName}
                onChange={(e) => setNewBoardName(e.target.value)}
                placeholder="Board name (e.g. AMOLED Cyberpunk)..."
                className="flex-1 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none"
                autoFocus
              />
              <button type="submit" className="bg-brand-500 text-white font-bold text-xs px-4 py-2 rounded-xl">Create</button>
              <button type="button" onClick={() => setShowNewBoardInput(false)} className="text-slate-400 p-2"><Icon name="x" className="w-4 h-4" /></button>
            </form>
          )}

          <div className="flex items-center gap-2 overflow-x-auto no-scrollbar pb-4 mb-6 border-b border-slate-200 dark:border-slate-800">
            <button
              onClick={() => setActiveBoardFilter('All')}
              className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${
                activeBoardFilter === 'All' ? 'bg-brand-500 text-white' : 'bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
              }`}
            >
              All Pins ({savedItems.length})
            </button>
            {userBoards.map(board => {
              const count = savedItems.filter(w => savedPins[w.id] === board).length;
              return (
                <button
                  key={board}
                  onClick={() => setActiveBoardFilter(board)}
                  className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${
                    activeBoardFilter === board ? 'bg-brand-500 text-white' : 'bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
                  }`}
                >
                  {board} ({count})
                </button>
              );
            })}
          </div>

          {filteredSavedItems.length === 0 ? (
            <div className="text-center py-20 bg-slate-100/50 dark:bg-slate-900/30 rounded-3xl border border-dashed border-slate-300 dark:border-slate-800">
              <Icon name="pin" className="w-12 h-12 text-slate-400 mx-auto mb-3" />
              <h3 className="text-base font-bold text-slate-900 dark:text-white">No Wallpapers Saved in this Board</h3>
              <p className="text-xs text-slate-400 mt-1">Explore 4K wallpapers and click "Save" to populate this collection.</p>
            </div>
          ) : (
            <div className="columns-1 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-5 masonry-columns">
              {filteredSavedItems.map(wallpaper => (
                <WallpaperCard
                  key={wallpaper.id}
                  wallpaper={wallpaper}
                  onSelect={onSelectWallpaper}
                  onSavePin={onSavePin}
                  isSaved={true}
                  savedBoard={savedPins[wallpaper.id]}
                  onToggleLike={onToggleLike}
                  isLiked={likedIds.has(wallpaper.id)}
                  onQuickDownload={onQuickDownload}
                  onOpenSendEmailModal={onOpenSendEmailModal}
                  userBoards={userBoards}
                />
              ))}
            </div>
          )}
        </div>
      );
    };

    const EmailHubView = ({ userEmail, setUserEmail, onOpenNewsletterModal, addToast }) => {
      const [sentLogs, setSentLogs] = useState(() => {
        try { return JSON.parse(localStorage.getItem('paperpin_sent_emails') || '[]'); } catch(e) { return []; }
      });

      const clearLogs = () => {
        localStorage.removeItem('paperpin_sent_emails');
        setSentLogs([]);
        addToast({ title: 'Logs Cleared', message: 'Sent email history reset.', type: 'info' });
      };

      return (
        <div className="max-w-4xl mx-auto px-4 py-8">
          <div className="p-6 sm:p-8 rounded-3xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl mb-8">
            <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 rounded-2xl bg-sky-500/20 text-sky-500 flex items-center justify-center">
                  <Icon name="mail" className="w-6 h-6" />
                </div>
                <div>
                  <h2 className="text-xl font-extrabold text-slate-900 dark:text-white">Email Address Center</h2>
                  <p className="text-xs text-slate-400">Manage email subscriptions, dispatched wallpapers, and board exports</p>
                </div>
              </div>

              <button
                onClick={onOpenNewsletterModal}
                className="px-4 py-2 bg-amber-500 text-white font-bold text-xs rounded-full shadow-md flex items-center gap-1.5"
              >
                <Icon name="bell" className="w-3.5 h-3.5" />
                Daily Digest Settings
              </button>
            </div>

            <div className="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div className="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60">
                <p className="text-[10px] font-extrabold uppercase text-slate-400 mb-1">Active Email Profile</p>
                <p className="text-sm font-bold text-slate-900 dark:text-white">{userEmail || 'Not Signed In'}</p>
                <p className="text-[11px] text-slate-400 mt-2">Used for board exports and subscription digests.</p>
              </div>

              <div className="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60">
                <p className="text-[10px] font-extrabold uppercase text-slate-400 mb-1">Total Wallpapers Email Sent</p>
                <p className="text-xl font-extrabold text-sky-500">{sentLogs.length}</p>
                <p className="text-[11px] text-slate-400 mt-1">Direct wallpaper emails dispatched.</p>
              </div>
            </div>
          </div>

          {/* Sent History Log Table */}
          <div className="p-6 rounded-3xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                <Icon name="inbox" className="w-4 h-4 text-sky-500" />
                Sent Wallpapers History Log
              </h3>
              {sentLogs.length > 0 && (
                <button onClick={clearLogs} className="text-xs font-bold text-rose-500 hover:underline">Clear History</button>
              )}
            </div>

            {sentLogs.length === 0 ? (
              <div className="text-center py-10 text-slate-400 text-xs">
                No emails dispatched yet. Click "Send to Email" on any wallpaper to send high-res links!
              </div>
            ) : (
              <div className="space-y-3">
                {sentLogs.map((log) => (
                  <div key={log.id} className="p-3.5 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-between gap-3 border border-slate-200 dark:border-slate-700/60">
                    <div className="flex items-center gap-3 min-w-0">
                      <img src={log.wallpaperUrl} alt={log.wallpaperTitle} className="w-10 h-10 rounded-lg object-cover shrink-0" />
                      <div className="min-w-0">
                        <p className="text-xs font-bold text-slate-900 dark:text-white truncate">{log.wallpaperTitle}</p>
                        <p className="text-[10px] text-slate-400">To: <span className="text-sky-400">{log.to}</span> • {log.sentAt}</p>
                      </div>
                    </div>
                    <span className="px-2.5 py-1 rounded-full bg-sky-500/10 text-sky-500 text-[10px] font-extrabold shrink-0">
                      {log.resolution}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      );
    };

    const App = () => {
      // Wallpapers State
      const [wallpapers, setWallpapers] = useState(() => {
        const custom = localStorage.getItem('paperpin_custom_wallpapers');
        const customParsed = custom ? JSON.parse(custom) : [];
        const seedMapped = UNSPLASH_PHOTO_SEED.map(item => ({
          ...item,
          imageUrl: getUnsplashUrl(item.id, 900, 85),
          creator: {
            name: 'PaperPin Studio',
            avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80',
            handle: '@paperpin_4k'
          },
          likes: Math.floor(1800 + Math.random() * 2000),
          downloads: Math.floor(1100 + Math.random() * 1500),
          createdAt: '2026-09-20'
        }));
        return [...customParsed, ...seedMapped];
      });

      // User Account & Email State
      const [userEmail, setUserEmail] = useState(() => localStorage.getItem('paperpin_user_email') || 'alex.design@paperpin.io');

      // LocalStorage Persisted States
      const [savedPins, setSavedPins] = useState(() => {
        try { return JSON.parse(localStorage.getItem('paperpin_saved_pins')) || { 'pin-1': 'Favorites' }; } catch(e) { return {}; }
      });

      const [userBoards, setUserBoards] = useState(() => {
        try { return JSON.parse(localStorage.getItem('paperpin_boards')) || INITIAL_BOARDS; } catch(e) { return INITIAL_BOARDS; }
      });

      const [likedIds, setLikedIds] = useState(() => {
        try { return new Set(JSON.parse(localStorage.getItem('paperpin_likes'))); } catch(e) { return new Set(); }
      });

      const [darkMode, setDarkMode] = useState(() => {
        const saved = localStorage.getItem('paperpin_theme');
        return saved ? saved === 'dark' : true;
      });

      // UI States
      const [activeTab, setActiveTab] = useState('explore'); // 'explore', 'trending', 'saved', 'email-hub'
      const [selectedCategory, setSelectedCategory] = useState('All');
      const [selectedAspect, setSelectedAspect] = useState('all');
      const [selectedPalette, setSelectedPalette] = useState(null);
      const [searchQuery, setSearchQuery] = useState('');
      
      // Modals
      const [selectedWallpaper, setSelectedWallpaper] = useState(null);
      const [sendEmailWallpaper, setSendEmailWallpaper] = useState(null);
      const [isUploadOpen, setIsUploadOpen] = useState(false);
      const [isNewsletterOpen, setIsNewsletterOpen] = useState(false);
      const [isEmailBoardsOpen, setIsEmailBoardsOpen] = useState(false);
      const [isAccountOpen, setIsAccountOpen] = useState(false);
      const [toasts, setToasts] = useState([]);

      // Sync dark mode HTML class
      useEffect(() => {
        const root = document.documentElement;
        if (darkMode) {
          root.classList.add('dark');
          localStorage.setItem('paperpin_theme', 'dark');
        } else {
          root.classList.remove('dark');
          localStorage.setItem('paperpin_theme', 'light');
        }
      }, [darkMode]);

      useEffect(() => { localStorage.setItem('paperpin_saved_pins', JSON.stringify(savedPins)); }, [savedPins]);
      useEffect(() => { localStorage.setItem('paperpin_boards', JSON.stringify(userBoards)); }, [userBoards]);
      useEffect(() => { localStorage.setItem('paperpin_likes', JSON.stringify(Array.from(likedIds))); }, [likedIds]);
      useEffect(() => { localStorage.setItem('paperpin_user_email', userEmail); }, [userEmail]);

      const addToast = ({ title, message, type = 'info', icon = 'info' }) => {
        const id = Date.now() + Math.random();
        setToasts(prev => [...prev, { id, title, message, type, icon }]);
        setTimeout(() => setToasts(prev => prev.filter(t => t.id !== id)), 3800);
      };

      const removeToast = (id) => setToasts(prev => prev.filter(t => t.id !== id));

      const handleSavePin = (wallpaperId, boardName) => {
        setSavedPins(prev => {
          const updated = { ...prev };
          if (boardName === null) {
            delete updated[wallpaperId];
            addToast({ title: 'Unpinned', message: 'Removed from board', type: 'info', icon: 'bookmark' });
          } else {
            updated[wallpaperId] = boardName;
            addToast({ title: `Saved to ${boardName}`, message: 'Pinned to board collection', type: 'success', icon: 'pin' });
          }
          return updated;
        });
      };

      const handleToggleLike = (wallpaperId) => {
        setLikedIds(prev => {
          const next = new Set(prev);
          if (next.has(wallpaperId)) next.delete(wallpaperId);
          else {
            next.add(wallpaperId);
            addToast({ title: 'Liked Pin!', message: 'Added to favorites', type: 'success', icon: 'heart' });
          }
          return next;
        });
      };

      const handleDownload = (wallpaper, resLabel = '4K Ultra') => {
        addToast({ title: `Downloading ${wallpaper.title}`, message: `Preparing high-res ${resLabel}...`, type: 'success', icon: 'download' });
        setWallpapers(prev => prev.map(w => w.id === wallpaper.id ? { ...w, downloads: w.downloads + 1 } : w));
        const a = document.createElement('a');
        a.href = wallpaper.imageUrl;
        a.download = `PaperPin_${wallpaper.title.replace(/\s+/g, '_')}_${resLabel}.jpg`;
        a.target = '_blank';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      };

      const handleAddWallpaper = (newPin) => {
        const customPins = JSON.parse(localStorage.getItem('paperpin_custom_wallpapers') || '[]');
        localStorage.setItem('paperpin_custom_wallpapers', JSON.stringify([newPin, ...customPins]));
        setWallpapers(prev => [newPin, ...prev]);
      };

      const handleCreateBoard = (boardName) => {
        if (!userBoards.includes(boardName)) {
          setUserBoards(prev => [...prev, boardName]);
          addToast({ title: 'Board Created', message: `Created "${boardName}"`, type: 'success', icon: 'folder-plus' });
        }
      };

      // Filtered wallpapers including dynamic query search engine
      const displayedWallpapers = useMemo(() => {
        let list = [...wallpapers];

        // If user typed a search query that returns 0 items in static pool, dynamically construct high-res dynamic wallpapers!
        if (searchQuery.trim()) {
          const q = searchQuery.toLowerCase().trim();
          let filtered = list.filter(item => 
            item.title.toLowerCase().includes(q) ||
            item.category.toLowerCase().includes(q) ||
            item.creator.name.toLowerCase().includes(q) ||
            item.tags.some(tag => tag.toLowerCase().includes(q))
          );

          if (filtered.length < 4) {
            const dynamicGenerated = generateDynamicWallpapersForQuery(q, 10);
            filtered = [...filtered, ...dynamicGenerated];
          }
          list = filtered;
        }

        if (activeTab === 'trending') {
          list.sort((a, b) => b.likes - a.likes);
        }

        if (selectedCategory !== 'All') {
          list = list.filter(item => item.category.toLowerCase() === selectedCategory.toLowerCase());
        }

        if (selectedAspect !== 'all') {
          list = list.filter(item => item.aspectRatio === selectedAspect);
        }

        return list;
      }, [wallpapers, activeTab, selectedCategory, selectedAspect, searchQuery]);

      return (
        <div className="min-h-screen flex flex-col">
          <Navbar
            searchQuery={searchQuery}
            setSearchQuery={setSearchQuery}
            activeTab={activeTab}
            setActiveTab={setActiveTab}
            onOpenUpload={() => setIsUploadOpen(true)}
            onOpenAccountModal={() => setIsAccountOpen(true)}
            onOpenNewsletterModal={() => setIsNewsletterOpen(true)}
            darkMode={darkMode}
            setDarkMode={setDarkMode}
            savedCount={Object.keys(savedPins).length}
            userEmail={userEmail}
          />

          <main className="flex-1">
            {activeTab === 'email-hub' ? (
              <EmailHubView
                userEmail={userEmail}
                setUserEmail={setUserEmail}
                onOpenNewsletterModal={() => setIsNewsletterOpen(true)}
                addToast={addToast}
              />
            ) : activeTab === 'saved' ? (
              <SavedPinsView
                savedPins={savedPins}
                wallpapers={wallpapers}
                userBoards={userBoards}
                onCreateBoard={handleCreateBoard}
                onSelectWallpaper={setSelectedWallpaper}
                onSavePin={handleSavePin}
                onToggleLike={handleToggleLike}
                likedIds={likedIds}
                onQuickDownload={handleDownload}
                onOpenSendEmailModal={(wp) => setSendEmailWallpaper(wp)}
                onOpenEmailBoardsModal={() => setIsEmailBoardsOpen(true)}
              />
            ) : (
              <div>
                <CategoryAndFilterBar
                  categories={CATEGORIES}
                  selectedCategory={selectedCategory}
                  setSelectedCategory={setSelectedCategory}
                  selectedAspect={selectedAspect}
                  setSelectedAspect={setSelectedAspect}
                  selectedPalette={selectedPalette}
                  setSelectedPalette={setSelectedPalette}
                />

                <div className="max-w-[1700px] mx-auto px-4 sm:px-6 my-6">
                  <div className="columns-1 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-5 masonry-columns">
                    {displayedWallpapers.map(wallpaper => (
                      <WallpaperCard
                        key={wallpaper.id}
                        wallpaper={wallpaper}
                        onSelect={setSelectedWallpaper}
                        onSavePin={handleSavePin}
                        isSaved={!!savedPins[wallpaper.id]}
                        savedBoard={savedPins[wallpaper.id]}
                        onToggleLike={handleToggleLike}
                        isLiked={likedIds.has(wallpaper.id)}
                        onQuickDownload={handleDownload}
                        onOpenSendEmailModal={(wp) => setSendEmailWallpaper(wp)}
                        userBoards={userBoards}
                      />
                    ))}
                  </div>
                </div>
              </div>
            )}
          </main>

          {/* Account Modal */}
          {isAccountOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md animate-fade-in">
              <div className="fixed inset-0" onClick={() => setIsAccountOpen(false)}></div>
              <div className="relative w-full max-w-sm bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 p-6 z-10 animate-scale-up">
                <div className="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800 mb-4">
                  <h3 className="text-base font-extrabold text-slate-900 dark:text-white">Email Profile Settings</h3>
                  <button onClick={() => setIsAccountOpen(false)} className="p-1 text-slate-400"><Icon name="x" className="w-5 h-5" /></button>
                </div>

                <div className="space-y-4">
                  <div>
                    <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Your Email Address</label>
                    <input
                      type="email"
                      value={userEmail}
                      onChange={(e) => setUserEmail(e.target.value)}
                      placeholder="email@example.com"
                      className="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-semibold"
                    />
                  </div>

                  <button
                    onClick={() => {
                      addToast({ title: 'Email Updated', message: `Saved email as ${userEmail}`, type: 'success' });
                      setIsAccountOpen(false);
                    }}
                    className="w-full py-2.5 bg-brand-500 text-white font-bold text-xs rounded-full shadow-lg"
                  >
                    Save Email Account
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* Modals */}
          {selectedWallpaper && (
            <WallpaperModal
              wallpaper={selectedWallpaper}
              onClose={() => setSelectedWallpaper(null)}
              onSavePin={handleSavePin}
              isSaved={!!savedPins[selectedWallpaper.id]}
              savedBoard={savedPins[selectedWallpaper.id]}
              onToggleLike={handleToggleLike}
              isLiked={likedIds.has(selectedWallpaper.id)}
              onDownload={handleDownload}
              onOpenSendEmailModal={(wp) => setSendEmailWallpaper(wp)}
              userBoards={userBoards}
              onSelectTag={(tag) => { setSearchQuery(tag); setActiveTab('explore'); }}
              allWallpapers={wallpapers}
              onSelectWallpaper={setSelectedWallpaper}
              addToast={addToast}
            />
          )}

          <SendToEmailModal
            wallpaper={sendEmailWallpaper}
            isOpen={!!sendEmailWallpaper}
            onClose={() => setSendEmailWallpaper(null)}
            addToast={addToast}
            userEmail={userEmail}
          />

          <EmailBoardsModal
            isOpen={isEmailBoardsOpen}
            onClose={() => setIsEmailBoardsOpen(false)}
            savedItems={wallpapers.filter(w => savedPins[w.id])}
            userEmail={userEmail}
            addToast={addToast}
          />

          <NewsletterModal
            isOpen={isNewsletterOpen}
            onClose={() => setIsNewsletterOpen(false)}
            addToast={addToast}
            userEmail={userEmail}
            setUserEmail={setUserEmail}
          />

          <UploadModal
            isOpen={isUploadOpen}
            onClose={() => setIsUploadOpen(false)}
            onAddWallpaper={handleAddWallpaper}
            categories={CATEGORIES}
            addToast={addToast}
          />

          <ToastContainer toasts={toasts} removeToast={removeToast} />
        </div>
      );
    };

    const rootElement = document.getElementById('root');
    const root = ReactDOM.createRoot(rootElement);
    root.render(<App />);

  </script>
</body>
</html>
