                <div>
                  <label className="block text-xs font-bold uppercase text-slate-400 mb-1">Resolution</label>
                  <select
                    value={resolution}
                    onChange={(e) => setResolution(e.target.value)}
                    className="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl px-2.5 py-2 text-xs font-semibold"
                  >
                    <option value="4K Ultra">4K Ultra</option>
                    <option value="8K Ultra">8K Ultra</option>
