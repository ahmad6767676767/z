      { id: '1550684848-fac1c5b4e853', title: 'Synthwave Sunset Highway 80s', category: 'Cyberpunk', aspectRatio: 'tall', aspectLabel: '9:16 Mobile', resolution: '4K Ultra', palette: ['#1e1b4b', '#4338ca', '#d946ef', '#fbbf24'], tags: ['synthwave', 'retro', 'cyberpunk', 'purple', 'neon'] },
